# ============================================================
# CONFIGURACIÓN DE DESARROLLO (compartida por el equipo)
# Cada integrante copia este archivo a ".env" (ver README).
# El archivo ".env" NO se sube a GitHub.
#
# Si el repositorio alguna vez se hace público, cambiá
# ROOT_PASSWORD y JWT_SECRET por valores nuevos.
# ============================================================

PORT=3000

# MySQL de XAMPP (la base "vestuario" tiene que existir)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=vestuario

# Clave para firmar las sesiones (valor de desarrollo)
JWT_SECRET=vestuario-dev-secret-cambiar-si-el-repo-se-hace-publico-0123456789

# Origen de la web (puerto de Expo web)
WEB_ORIGIN=http://localhost:8081,http://localhost:19006

# Cuenta Root: se crea la primera vez que arranca el servidor en cada PC.
# Después NO se vuelve a modificar.
ROOT_EMAIL=cazoncontreras.iara@tecnica7.edu.ar
ROOT_PASSWORD=Milena15

# Solo para reemplazar la clave Root en una base que ya la tiene. Normalmente NO se usa.
# RESET_ROOT_PASSWORD=true

# EmailJS (opcional): sin esto todo funciona, solo que "Olvidé mi contraseña" no manda el mail.
# Requiere activar en EmailJS: Account > Security > "Allow EmailJS API for non-browser applications"
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
