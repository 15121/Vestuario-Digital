# ============================================================
# Plantilla de configuración del servidor (vestuario-server)
# Copiá este archivo a ".env" y completá los valores.
# El archivo ".env" NO se sube a GitHub. No pegues claves reales aquí.
# ============================================================

PORT=3000

# MySQL (la base "vestuario" tiene que existir)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=vestuario

# Clave para firmar las sesiones: mínimo 32 caracteres, generada por cada instalación.
# Ejemplo para generarla:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origen de la web (puerto de Expo web)
WEB_ORIGIN=http://localhost:8081,http://localhost:19006

# Cuenta Root: se crea la primera vez que arranca el servidor.
ROOT_EMAIL=cazoncontreras.iara@tecnica7.edu.ar
ROOT_PASSWORD=

# Solo para reemplazar la clave Root en una base que ya la tiene. Normalmente NO se usa.
# RESET_ROOT_PASSWORD=true

# EmailJS (opcional): sin esto todo funciona, salvo el mail de "Olvidé mi contraseña".
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
