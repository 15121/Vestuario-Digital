# Copiar este archivo como .env y completar con valores propios.
# El archivo .env NO se sube a GitHub.

# Dirección del servidor para la versión web (por ejemplo http://localhost:3000)
EXPO_PUBLIC_API_URL=

# OpenWeatherMap (clima)
EXPO_PUBLIC_OPENWEATHER_API_KEY=

# remove.bg (quitar fondo de las fotos)
EXPO_PUBLIC_REMOVE_BG_API_KEY=

# EmailJS (recuperación de contraseña en la versión móvil)
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=

# Clave inicial del Root en la base local del celular (SQLite). Solo para desarrollo,
# elegí una propia; NO se sube a GitHub. Sin ella el Root no se crea en el celular
# (en la web el Root lo crea el servidor con ROOT_PASSWORD).
EXPO_PUBLIC_ROOT_PASSWORD=
